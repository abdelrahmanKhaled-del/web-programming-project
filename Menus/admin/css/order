body {
  font-family: 'Segoe UI', Arial, sans-serif;
  margin: 0;
  background: #ffffff;
  color: #333;
}

.header {
  background: #ff6600;
  color: white;
  padding: 20px;
  text-align: center;
}

.back {
  display: inline-block;
  margin: 20px;
  padding: 8px 14px;
  background: #4CAF50;
  color: white;
  text-decoration: none;
  border-radius: 50px;
  font-weight: bold;
}

.container {
  max-width: 900px;
  margin: 30px auto;
  padding: 20px;
}

.order-card {
  background: #fff;
  padding: 20px;
  margin-bottom: 20px;
  border-radius: 12px;
  box-shadow: 0 2px 6px rgba(0,0,0,0.1);
}

.status {
  font-weight: bold;
}

.status.pending {
  color: #e65100;
}

.status.assigned {
  color: #2e7d32;
}

select {
  padding: 8px;
  margin-top: 10px;
  border-radius: 6px;
}

button {
  background: #4CAF50;
  color: white;
  border: none;
  padding: 8px 14px;
  border-radius: 50px;
  cursor: pointer;
  margin-top: 10px;
}

button:hover {
  background: #388E3C;
}

.success-msg {
  background: #e8f5e9;
  color: #2e7d32;
  padding: 12px;
  border-radius: 8px;
  margin-bottom: 20px;
  text-align: center;
  font-weight: bold;
}

.assigned-label {
  margin-top: 10px;
  color: #555;
  font-style: italic;
}
