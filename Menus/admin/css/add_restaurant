body {
    margin: 0;
    font-family: 'Segoe UI', Arial, sans-serif;
    background: #f9fafc;
    color: #333;
}

.header {
    background: #ff6600;
    color: white;
    padding: 20px;
    text-align: center;
    box-shadow: 0 2px 6px rgba(0,0,0,0.1);
}

.container {
    display: flex;
    justify-content: center;
    margin-top: 40px;
}

.card {
    background: #fff;
    padding: 25px;
    width: 350px;
    border-radius: 10px;
    box-shadow: 0 2px 8px rgba(0,0,0,0.1);
}

h2 {
    margin-top: 0;
    color: #ff6600;
    text-align: center;
}

input[type="text"],
input[type="file"] {
    width: 100%;
    padding: 10px;
    margin: 10px 0;
    border: 1px solid #ccc;
    border-radius: 6px;
    font-size: 14px;
}

button {
    width: 100%;
    padding: 12px;
    background: #ff6600;
    color: white;
    border: none;
    border-radius: 6px;
    cursor: pointer;
    font-size: 15px;
    font-weight: bold;
    transition: background 0.3s ease;
}

button:hover {
    background: #e65c00;
}

.message {
    text-align: center;
    margin-bottom: 10px;
    color: green;
    font-size: 14px;
}

.back {
    display: block;
    text-align: center;
    margin-top: 15px;
    color: #ff6600;
    text-decoration: none;
    font-size: 14px;
}

.back:hover {
    text-decoration: underline;
}

/* Restaurant List */
.list-container {
    max-width: 600px;
    margin: 40px auto;
    padding: 20px;
}

.restaurant-card {
    background: #fff;
    padding: 12px 16px;
    margin: 10px 0;
    border-radius: 6px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    box-shadow: 0 1px 4px rgba(0,0,0,0.1);
}

.restaurant-card .info {
    display: flex;
    align-items: center;
    gap: 12px;
}

.restaurant-card img {
    height: 50px;
    width: 50px;
    object-fit: cover;
    border-radius: 6px;
}

.restaurant-card p {
    margin: 0;
    font-weight: bold;
    color: #333;
}

.delete {
    background: #e53935;
    color: white;
    padding: 6px 12px;
    border-radius: 6px;
    text-decoration: none;
    font-size: 13px;
    transition: background 0.3s ease;
}

.delete:hover {
    background: #c62828;
}

.empty {
    text-align: center;
    color: #999;
    font-style: italic;
}
